{
  "informative": [
    "Target topology: Docker tiny topology (topology/tiny.topo), marketplace in AS 111.",
    "",
    "+-----------------+            +-----------------+            +-------------------------+",
    "| AS 1-ff00:0:111 |            | AS 1-ff00:0:110 |            | AS 1-ff00:0:112         |",
    "| marketplace     |            | (core)          |            | server :12345           |",
    "| hummingbird-1   |#41-------#1| best-effort-1   |#2--------#1| fd00:f00d:cafe::7f00:15 |",
    "| 172.20.0.29     |            | 172.20.0.22     |            |                         |",
    "+-----------------+            +-----------------+            +-------------------------+",
    "",
    "#N are interface IDs. Both inter-AS links are shaped by the tc settings below.",
    "hummingbird-1 (111) -> 110 -> 112 uses a reservation; best-effort-1 (110) -> 112",
    "sends best-effort traffic over the 110 - 112 link."
  ],
  "hummingbird": {
    "reservation_source": "marketplace",
    "marketplace": {
      "url": "https://127.0.0.1:8888",
      "username": "alice",
      "password_env": "HUMMBWTESTER_MARKETPLACE_PASSWORD"
    }
  },
  "server": {
    "isd_as": "1-ff00:0:112",
    "host": "fd00:f00d:cafe::7f00:15",
    "port": 12345,
    "receive_buffer_size": 4194304
  },
  "hummingbird_clients": [
    {
      "client_id": "hummingbird-1",
      "isd_as": "1-ff00:0:111",
      "host": "172.20.0.29",
      "port": 0,
      "bandwidth": "5Mbps",
      "maxburst": "50Mbps",
      "duration": "3h",
      "hummingbird_reservation": {
        "bandwidth": "5mbps",
        "duration": "5m",
        "reverse_bandwidth": "5mbps",
        "renewal_ahead": "30s",
        "reservation_overlap": "20s",
        "humm_start_offset": "-5s"
      }
    }
  ],
  "best_effort_clients": [
    {
      "client_id": "best-effort-1",
      "isd_as": "1-ff00:0:110",
      "host": "172.20.0.22",
      "port": 0,
      "bandwidth": "10Mbps",
      "maxburst": "20Mbps",
      "duration": "3h"
    }
  ],
  "deployment": {
    "kind": "docker",
    "router": {
      "send_buffer_size": 16384,
      "receive_buffer_size": 4194304,
      "ingress_batch_size": 64,
      "processor_queue_size": 640,
      "egress_batch_size": 1,
      "egress_queue_size": 640
    }
  },
  "tc": {
    "rate": "10mbit",
    "burst": "50kb",
    "limit": "256kb"
  }
}
