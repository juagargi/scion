            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "white",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^hummingbird-.* send-receive gap$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^best-effort-.* send-receive gap$"
            },
            "properties": [
              {
