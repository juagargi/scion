          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "sum by (reason) (increase(router_dropped_priority_pkts_total{display!=\"false\",reason=~\"busy_forwarder|egress_down\"}[1m])) > 0",
          "legendFormat": "priority drops: {{reason}}"
        },
        {
          "editorMode": "code",
          "range": true,
          "refId": "B",
          "expr": "sum((( sum by (isd_as, neighbor_isd_as, interface) ( increase(router_output_pkts_total{display!=\"false\",interface=~\"[0-9]+\"}[1m]) and on (as, br) (min_over_time(up{job=\"scion-border-routers\",display!=\"false\"}[1m]) == 1) ) ) - on (isd_as, neighbor_isd_as) group_left (rx_interface) ( sum by (isd_as, neighbor_isd_as, rx_interface) ( label_replace(label_replace(label_replace(label_replace( increase(router_input_pkts_total{display!=\"false\",interface=~\"[0-9]+\"}[1m]) and on (as, br) (min_over_time(up{job=\"scion-border-routers\",display!=\"false\"}[1m]) == 1), \"rx_interface\", \"$1\", \"interface\", \"(.*)\"), \"swap\", \"$1\", \"isd_as\", \"(.*)\"), \"isd_as\", \"$1\", \"neighbor_isd_as\", \"(.*)\"), \"neighbor_isd_as\", \"$1\", \"swap\", \"(.*)\") ) )) >= 30)",
          "legendFormat": "network loss, all links"
        },
        {
          "editorMode": "code",
          "range": true,
          "refId": "C",
          "expr": "sum by (as, interface) (increase(router_bfd_state_changes_total{display!=\"false\"}[1m])) > 0",
          "legendFormat": "BFD state changes {{as}} #{{interface}}"
        },
        {
          "editorMode": "code",
          "range": true,
          "refId": "D",
          "expr": "sum(count_over_time(up{job=\"scion-border-routers\",display!=\"false\"}[1m]) - sum_over_time(up{job=\"scion-border-routers\",display!=\"false\"}[1m])) > 0",
          "legendFormat": "network loss unknown (router scrape failed)"
        }
      ],
      "title": "Priority Drops vs Network Loss and BFD",
      "type": "timeseries"
    }
