          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg_over_time(hummbwtester_client_remote_receive_rate_bps[60s])",
          "legendFormat": "{{client_id}} receive rate",
          "range": true,
          "refId": "A"
