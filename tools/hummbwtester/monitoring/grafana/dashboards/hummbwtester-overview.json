                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 7
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "text",
                  "mode": "fixed"
                }
              },
              {
                "id": "unit",
                "value": "suffix: failed scrapes/min"
              }
            ]
          }
        ]
      },
